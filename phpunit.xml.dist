<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache">
    <!--
        Pest test files are closures, not classes, so they carry no `Test.php`
        suffix; the suite is matched on the extension instead.

        One known upstream deprecation is silenced precisely, in tests/Pest.php,
        rather than here.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory suffix=".php">tests/Unit</directory>
        </testsuite>
        <!--
            The OOXML gate is a suite of its own, so that the jobs which run the
            rest of the suite can leave it out. The runner's image carries a .NET
            SDK, so the gate would otherwise run in every one of them, and the
            validator would be built from nuget.org each time.
        -->
        <testsuite name="ooxml">
            <directory suffix=".php">tests/Ooxml</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!--
            Collecting coverage runs out of the default 128M: every document-writing
            test goes through PHPWord, and the coverage driver keeps a record of every
            line each one touched. The limit is raised here rather than in a command
            so a local run and a continuous integration run behave the same way.
        -->
        <ini name="memory_limit" value="1G"/>
    </php>
</phpunit>
