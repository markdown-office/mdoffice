#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * `mdoffice` — Markdown to Word and to PowerPoint.
 *
 * This file works three ways, all of them the same code:
 *
 *  - run from a checkout: `php bin/mdoffice word README.md -o README.docx`
 *  - run as the phar: `php mdoffice.phar word README.md -o README.docx`
 *  - installed on your `PATH` as `mdoffice`
 *
 * The autoloader is looked for in both places rather than one, which is what lets
 * the same script serve a checkout and a phar without either knowing about the
 * other.
 */

use MarkdownOffice\Console\Application;

// PHP's own default is 128M, and a deck with pictures in it needs more than that: a
// 28-slide deck ran out of memory rather than out of slides. The released executable
// carries no `php.ini` to change, so the limit is raised here — every way of running
// this program goes through this file, the archive and the self-contained executable
// included.
//
// Only upwards. A machine that gave the program more than this keeps what it gave.
$wanted = 2 * 1024 * 1024 * 1024;
$given = ini_get('memory_limit');

if ($given !== false && $given !== '-1') {
    $bytes = (int) $given;
    $unit = strtoupper((string) substr($given, -1));

    $bytes *= match ($unit) {
        'G' => 1024 * 1024 * 1024,
        'M' => 1024 * 1024,
        'K' => 1024,
        default => 1,
    };

    if ($bytes < $wanted) {
        ini_set('memory_limit', (string) $wanted);
    }
}

(static function (): void {
    $candidates = [
        // Inside a phar `__DIR__` is `phar://…/app/bin`, so this is the archive's
        // own `app/vendor`; in a checkout it is the project's `vendor`.
        __DIR__ . '/../vendor/autoload.php',
        // A composer install of the tool as somebody else's dependency.
        __DIR__ . '/../../../autoload.php',
    ];

    foreach ($candidates as $candidate) {
        if (file_exists($candidate)) {
            require $candidate;

            return;
        }
    }

    fwrite(
        STDERR,
        'mdoffice: the dependencies are not installed.' . PHP_EOL
        . 'Run `composer install` in the project directory, or download a release from' . PHP_EOL
        . 'https://github.com/markdown-office/mdoffice/releases' . PHP_EOL,
    );

    exit(1);
})();

// `$argv` is defined by the CLI SAPI and by nothing else, so a file that also has
// to be includable — and this one is the phar's stub — reads it guarded. The
// empty case is the one the application already handles: it prints its usage.
exit((new Application())->run(array_slice($argv ?? [], 1)));