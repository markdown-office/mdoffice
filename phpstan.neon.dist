# PHPStan, fetched by checksum rather than installed as a dependency — see
# tools/install-phpstan.php for the version and the hash.
#
# Level 9, with no `ignoreErrors`, no baseline and no suppression comment anywhere in
# this repository.
#
# `tests/Unit` is not analysed: every test there is a closure handed to `it()` and
# every assertion goes through `expect()`, both resolved at run time, so an analyser
# given neither can only report the functions as unknown. The support code those tests
# lean on is analysed, and the array shapes live there.
  parameters:
      level: 9

      paths:
          - src
          - tests/Support
          - tools/build-phar.php
          - tools/extension-probe.php
          - tools/smoke-binary.php
          - tools/install-phpstan.php
