# PHPStan, fetched by checksum rather than installed as a dependency — see
  # tools/install-phpstan.php for the version and the hash.
  #
  # Level 9, with no `ignoreErrors`, no baseline and no suppression comment anywhere
  # in this repository.
  #
  # `tests/Unit` is not analysed: every one of its tests is a closure handed to `it()`
  # and every assertion goes through `expect()`, both of which resolve at run time, so
  # an analyser given neither can only report that the functions are unknown. The
  # support code those tests lean on *is* analysed, and it is where the array shapes
  # live.
  #
  # `tools/build-phar.php` is analysed as source, and it is the largest file here: it
  # resolves dependencies, assembles an archive and runs it.
  parameters:
      level: 9

      paths:
          - src
          - tests/Support
          - tools/build-phar.php
          - tools/install-phpstan.php