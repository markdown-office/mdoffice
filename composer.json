{
    "name": "markdown-office/mdoffice",
    "description": "The command line for markdown-office: Markdown to Word and to PowerPoint, in one program, as a PHAR and as a self-contained executable.",
    "type": "library",
    "keywords": [
        "markdown",
        "docx",
        "pptx",
        "word",
        "powerpoint",
        "slides",
        "cli",
        "phar",
        "converter",
        "static-php"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Fabian Gra\u00dfl",
            "email": "mail@fabiangrassl.de"
        }
    ],
    "require": {
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-xmlwriter": "*",
        "ext-zip": "*",
        "markdown-office/markdown-presentation": "^0.2",
        "markdown-office/markdown-word": "^0.2",
        "php": "^8.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../markdown-presentation",
            "options": {
                "versions": {
                    "markdown-office/markdown-presentation": "0.2.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../markdown-word",
            "options": {
                "versions": {
                    "markdown-office/markdown-word": "0.2.x-dev"
                }
            }
        }
    ],
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MarkdownOffice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarkdownOffice\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/mdoffice"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "cweagans/composer-patches": true
        }
    },
    "scripts": {
        "test": "pest",
        "check": [
            "@composer validate --no-check-publish",
            "@cli",
            "@test"
        ],
        "cli": "@php bin/mdoffice --version",
        "build:phar": "@php -d phar.readonly=0 tools/build-phar.php",
        "coverage": "@php -d pcov.enabled=1 vendor/bin/pest --coverage --min=90"
    },
    "scripts-descriptions": {
        "check": "Everything the suite of this repository can check without a network: the manifest, the binary answering for itself, and the tests.",
        "coverage": "The coverage gate the analysis job and the pull request both run. 90 rather than 100, and the reason is in the workflow that runs it."
    }
}
